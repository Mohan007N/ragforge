# ==========================================================
# RAGForge - Production Environment Configuration
# Copy this file to .env.production and populate values
# ==========================================================

# ----------------- Application Settings -----------------
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0
WORKERS=4

# ----------------- Security & Authentication -----------------
# Set to 'true' to require API key authentication on protected endpoints
ENABLE_AUTH=false

# Comma-separated list of valid API keys for client access
API_KEYS=ragforge-prod-secret-key-change-this

# Comma-separated list of allowed CORS origins (e.g. your production domain)
ALLOWED_ORIGINS=https://ragforge.yourdomain.com,https://yourdomain.com

# ----------------- LLM Provider Configuration -----------------
# Google Gemini API key (Recommended for cloud hosting without GPU)
GOOGLE_API_KEY=

# Ollama local/remote server configuration
OLLAMA_BASE_URL=http://ollama:11434
DEFAULT_MODEL=phi3:mini
DEFAULT_TEMPERATURE=0.1

# ----------------- Retrieval & Embedding Parameters -----------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=150
SEMANTIC_TOP_K=10
BM25_TOP_K=10
HYBRID_WEIGHT_SEMANTIC=0.6
HYBRID_WEIGHT_BM25=0.4
FINAL_TOP_K=5
CHROMA_COLLECTION_NAME=ragforge_documents
